# =============================================================================
# ShipTrip dev environment. Copy to `.env` before `docker compose up`:
#
#     cp -n .env.example .env
#
# Both Django (via django-environ) and every Go service (via pkg/config) read
# this single file. The Go loaders accept Django's split POSTGRES_* vars, so
# there is no separate Go-only DATABASE_URL.
#
# Values here are DEV DEFAULTS — safe for docker-compose on a laptop, NOT for
# production. Generate real secrets (JWT, bearer token, S3 keys) for any
# deployed environment. Inside the compose network, services reach each other
# by service name (postgres:5432, redis:6379, minio:9000), NOT the host port
# remaps (e.g. host 6380 → redis).
# =============================================================================

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# ── Postgres (shared by Django + all Go services) ────────────────────────────
# §3 connection-pool budget: Django 20 + chat 30 + notif 10 + kyc 5 + 10 spare.
POSTGRES_DB=shiptrip
POSTGRES_USER=shiptrip
POSTGRES_PASSWORD=shiptrip-dev-pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Per-service Go pool caps (defaults live in each main.go; override to scale).
# CHAT_DB_MAX_CONNS=15
# NOTIF_DB_MAX_CONNS=10
# KYC_DB_MAX_CONNS=5

# ── Redis (pub/sub + streams + presence) ─────────────────────────────────────
# Compose-internal address. Host-side tooling uses localhost:6380 (see §7b).
REDIS_URL=redis://redis:6379/0

# ── JWT (HS256, shared secret — CLAUDE.md §G2) ───────────────────────────────
# Django signs; Go validates. MUST be identical on both sides.
JWT_HS256_SECRET=insecure-dev-jwt-secret-change-me
# JWT_ACCESS_TTL_SECONDS=300
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_LEEWAY_SECONDS=30

# ── Object storage (MinIO in dev, S3-compatible — CLAUDE.md §G4) ─────────────
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-dev-pw
# S3_BUCKET_KYC=shiptrip-kyc
# S3_BUCKET_PARCEL=shiptrip-parcel
# Path-style defaults on when S3_ENDPOINT_URL is set (MinIO needs it).
# S3_USE_PATH_STYLE=true

# ── KYC gRPC (Django server ⇄ Go kyc-service — CLAUDE.md §G5) ─────────────────
# Dev auth is bearer; production is mtls (not yet wired). The token below is
# read by BOTH Django's runkycgrpc command and Go's kyc-service — keep equal.
KYC_GRPC_TARGET=django-grpc:50051
GRPC_AUTH_MODE=bearer
GRPC_BEARER_TOKEN=insecure-dev-grpc-token-change-me

# ── FCM push fallback (notif-service) ────────────────────────────────────────
# Off by default — V1 ships dark until the fcm_token schema + Django publisher
# land. Flip to true and set PROJECT_ID + CREDENTIALS_PATH to enable.
FCM_ENABLED=false
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=

# ── Google OAuth (optional in dev) ───────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_IDS=
