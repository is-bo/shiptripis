# =============================================================================
# ShipTrip backend .env.example
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-50-random-bytes
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.shiptrip.local

# --- Postgres ---
POSTGRES_DB=shiptrip
POSTGRES_USER=shiptrip
POSTGRES_PASSWORD=shiptrip_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT (HS256 shared with Go services per CLAUDE.md G2) ---
JWT_HS256_SECRET=change-me-to-64-random-bytes
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=2592000
JWT_LEEWAY_SECONDS=30

# --- Google OAuth ---
# Comma-separated list of accepted aud (Android + iOS + web). At least one
# required for /api/auth/oauth/google to function.
GOOGLE_OAUTH_CLIENT_IDS=

# --- Password reset ---
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_MAX_ATTEMPTS=5

# --- gRPC (Django <-> Go) ---
# In docker-compose dev: bearer is permitted. Production: mtls only.
GRPC_AUTH_MODE=bearer
GRPC_INTERNAL_TOKEN=dev-only-bearer-rotate-in-prod
GRPC_DJANGO_BIND=0.0.0.0:50051

# --- Object storage (S3 abstraction; works with MinIO in dev) ---
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_dev
S3_SECRET_KEY=minio_dev_secret
S3_BUCKET_KYC=shiptrip-kyc
S3_BUCKET_PARCEL=shiptrip-parcel

# --- Sentry (optional in dev) ---
SENTRY_DSN=

# --- Stripe (V1 payment provider) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
