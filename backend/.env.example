# =============================================================================
# ShipTrip dev environment. Copy to `.env` before `docker compose up`:
#
#     cp -n .env.example .env
#
# Both Django (via django-environ) and every Go service (via pkg/config) read
# this single file. The Go loaders accept Django's split POSTGRES_* vars, so
# there is no separate Go-only DATABASE_URL.
#
# Values here are DEV DEFAULTS — safe for docker-compose on a laptop, NOT for
# production. Generate real secrets (JWT, bearer token, S3 keys) for any
# deployed environment. Inside the compose network, services reach each other
# by service name (postgres:5432, redis:6379, minio:9000), NOT the host port
# remaps (e.g. host 6380 → redis).
# =============================================================================

# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=insecure-dev-key-change-me
SHIPTRIP_ENVIRONMENT=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
# Production browser origins are comma-separated https origins; an empty CORS
# list is valid for native-client/API-only deployments.
# CORS_ALLOWED_ORIGINS=https://www.shiptrip.example
# CSRF_TRUSTED_ORIGINS=https://admin.shiptrip.example
# RELEASE_ID=git-sha-or-release-tag
# SENTRY_DSN=
# DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
# FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
# DRF_ANON_THROTTLE_RATE=60/min
# DRF_USER_THROTTLE_RATE=600/min
# DRF_REGISTRATION_THROTTLE_RATE=5/hour
# DRF_LOGIN_THROTTLE_RATE=10/min
# DRF_PASSWORD_RESET_THROTTLE_RATE=5/hour
# DRF_EMAIL_VERIFY_THROTTLE_RATE=10/hour
# DRF_GOOGLE_SIGNIN_THROTTLE_RATE=10/min
# DRF_MEDIA_UPLOAD_THROTTLE_RATE=20/hour
# DRF_CHAT_MESSAGE_THROTTLE_RATE=60/min
# DRF_ADMIN_INVITATION_THROTTLE_RATE=20/hour
# PAYMENTS_MOCK_WEBHOOK_ENABLED=false
# PAYMENTS_LEGACY_MUTATIONS_ENABLED=false

# ── Phase 2 matching/routing ────────────────────────────────────────────────
# Leave ROUTE_PROVIDER_CLASS empty until a reviewed production provider adapter
# is configured. `/api/routes/provider-status` then reports the capability as
# unavailable; matching uses the explicitly labelled spatial fallback allowed
# by the active BusinessSettingsVersion policy.
# ROUTE_PROVIDER_CLASS=package.module.ProviderAdapter
# ROUTE_PROVIDER_OPTIONS={"api_key":"use-a-secret-reference"}
# ROUTE_PROVIDER_CACHE_URL=redis://redis:6379/2
# Bump this namespace whenever provider/configuration/routing data semantics change.
ROUTE_PROVIDER_CACHE_NAMESPACE=v1
# ROUTE_PROVIDER_CACHE_TTL_SECONDS=86400
# ROUTE_PROVIDER_MAX_EXTERNAL_CALLS_PER_MATCHING_REQUEST=50
# DRF_MATCHING_DISCOVERY_THROTTLE_RATE=10/min
# DRF_JOURNEY_ROUTES_THROTTLE_RATE=10/min
# Database-backed pending-payment reservation sweep interval.
# RESERVATION_RELEASE_INTERVAL_SECONDS=60
# Durable financial job worker (deposit expiry refunds, checkout expiry,
# provider reconciliation, payout release checks). The `finance_scheduled_job`
# table is the obligation store; this only controls how often it is polled.
# FINANCE_JOB_INTERVAL_SECONDS=30

# ── Phase 3 payments ────────────────────────────────────────────────────────
# CREDENTIALS ONLY. Everything commercial — which providers are on, the posting
# deposit formula, the EUR->DZD rate, the payout protection window — lives in
# the versioned BusinessSettingsVersion policy so it is audited and snapshotted,
# never redeployed. See docs/PHASE3_PAYMENTS.md.
#
# Providers reach these URLs for redirects and webhooks, so it must be the
# public origin. Production refuses to boot without it, and refuses a non-https
# value.
# PAYMENTS_PUBLIC_BASE_URL=https://api.shiptrip.example
# PAYMENTS_PROVIDER_TIMEOUT_SECONDS=15

# The test-only payment rail. Production refuses to start when this is true, and
# nothing anywhere falls back to it when a real provider is misconfigured.
# Leave it false everywhere that handles real money.
PAYMENTS_ALLOW_MOCK_PROVIDER=true
# PAYMENTS_MOCK_WEBHOOK_ENABLED=false
# PAYMENTS_LEGACY_MUTATIONS_ENABLED=false

# Stripe (EUR customer checkout + third-party payer + payout capability).
# Both must be set together: a checkout that can be created but whose webhook
# cannot be verified is worse than no Stripe at all, and production refuses it.
# Use the sk_test_/whsec_ pair from a Stripe test mode account for development.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_API_BASE=https://api.stripe.com
# STRIPE_API_VERSION=
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Chargily (DZD settlement of a canonical EUR obligation).
# Chargily signs webhooks with the API secret key; CHARGILY_WEBHOOK_SECRET is an
# override for the day they split them. The API base decides test vs live along
# with the key: https://pay.chargily.net/test/api/v2 for test.
# CHARGILY_SECRET_KEY=test_sk_replace_me
# CHARGILY_WEBHOOK_SECRET=
# CHARGILY_API_BASE=https://pay.chargily.net/api/v2

# Throttles on the new payment surfaces. The guest one bounds token guessing;
# the webhook one is deliberately generous so a provider retry storm is never
# throttled into lost money.
# DRF_GUEST_PAYMENT_THROTTLE_RATE=20/min
# DRF_PAYMENT_CHECKOUT_THROTTLE_RATE=20/min
# DRF_PAYMENT_WEBHOOK_THROTTLE_RATE=1200/min

# ── Postgres (shared by Django + all Go services) ────────────────────────────
# §3 connection-pool budget: Django 20 + chat 30 + notif 10 + kyc 5 + 10 spare.
POSTGRES_DB=shiptrip
POSTGRES_USER=shiptrip
POSTGRES_PASSWORD=shiptrip-dev-pw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Railway may inject a single URL for Go services. Django currently consumes
# the split variables above, so keep them populated even when this is present.
# DATABASE_URL=postgresql://user:password@host:5432/shiptrip
# DJANGO_DB_CONN_MAX_AGE=60

# Per-service Go pool caps (defaults live in each main.go; override to scale).
# CHAT_DB_MAX_CONNS=15
# NOTIF_DB_MAX_CONNS=10
# KYC_DB_MAX_CONNS=5
# EMAIL_DB_MAX_CONNS=5
# CHAT_HTTP_ADDR=:8081
# NOTIF_HTTP_ADDR=:8082
# KYC_HTTP_ADDR=:8083
# EMAIL_HTTP_ADDR=:8085

# ── Redis (pub/sub + streams + presence) ─────────────────────────────────────
# Compose-internal address. Host-side tooling uses localhost:6380 (see §7b).
REDIS_URL=redis://redis:6379/0
# Go KYC upload limiter: one atomic Redis fixed window always consumes the
# authenticated-user budget. The optional hashed-IP dimension defaults off;
# enable it only after the ingress contract guarantees that clients cannot set
# the selected address source. Production's combined launcher separately
# requires KYC_RATE_LIMIT_REDIS_URL to point at Redis shared by every replica.
# KYC_UPLOAD_USER_LIMIT=6
# KYC_UPLOAD_USER_WINDOW_SECONDS=3600
# KYC_UPLOAD_IP_LIMIT=0
# KYC_UPLOAD_IP_WINDOW_SECONDS=0
# KYC_UPLOAD_CLIENT_IP_SOURCE=
# KYC_RATE_LIMIT_REDIS_URL=rediss://managed-shared-redis.example/0

# ── JWT (HS256, shared secret — CLAUDE.md §G2) ───────────────────────────────
# Django signs; Go validates. MUST be identical on both sides.
JWT_HS256_SECRET=insecure-dev-jwt-secret-change-me
# JWT_ACCESS_TTL_SECONDS=300
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_LEEWAY_SECONDS=30

# ── Object storage (MinIO in dev, S3-compatible — CLAUDE.md §G4) ─────────────
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-dev-pw
# S3_BUCKET_KYC=shiptrip-kyc
# S3_BUCKET_PARCEL=shiptrip-parcel
# Path-style defaults on when S3_ENDPOINT_URL is set (MinIO needs it).
# Set false for virtual-host-only providers such as new Railway buckets.
# S3_USE_PATH_STYLE=true

# ── KYC gRPC (Django server ⇄ Go kyc-service — CLAUDE.md §G5) ─────────────────
# Dev auth is bearer. The token below is read by BOTH Django's runkycgrpc
# command and Go's kyc-service — keep equal.
KYC_GRPC_TARGET=django-grpc:50051
GRPC_DJANGO_BIND=0.0.0.0:50051
GRPC_AUTH_MODE=bearer
GRPC_BEARER_TOKEN=insecure-dev-grpc-token-change-me
#
# Production auth is mTLS by default; both the Go client and Django server are
# wired. Paths are inside the containers and should be mounted as secrets.
# GRPC_TLS_CA_CERT=/run/secrets/grpc-ca.pem
# GRPC_TLS_CLIENT_CERT=/run/secrets/grpc-client.pem
# GRPC_TLS_CLIENT_KEY=/run/secrets/grpc-client.key
# GRPC_TLS_SERVER_CERT=/run/secrets/grpc-server.pem
# GRPC_TLS_SERVER_KEY=/run/secrets/grpc-server.key
#
# Railway may use a strong bearer token strictly over its private project
# network. This opt-in is rejected unless the token is at least 32 characters.
# GRPC_ALLOW_PRIVATE_BEARER=true

# ── FCM push fallback (notif-service) ────────────────────────────────────────
# Off by default. Enable only when the Firebase project matches the mobile
# build and CREDENTIALS_PATH points to a privately mounted service-account
# JSON file. Never copy that JSON into the repository or mobile app.
FCM_ENABLED=false
# FCM_STREAM=notif:fcm
# FCM_RESULTS_STREAM=notif:fcm:results
# FCM_CONSUMER_GROUP=notif-fcm-workers
# FCM_CONSUMER_NAME=notif-fcm-1
# FCM_RESULTS_CONSUMER_GROUP=notif-fcm-results-django
# FCM_RESULTS_CONSUMER_NAME=notif-fcm-results-django-1
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=
#
# Railway has no secret-file primitive, so the combined launcher accepts the
# Admin JSON base64-encoded in the platform secret store and writes it, at
# boot, to FCM_CREDENTIALS_PATH (default /tmp/shiptrip/firebase-admin.json)
# with owner-only permissions. It then drops the encoded value before any
# child process starts, so workers inherit the path and never the payload.
# Leave this unset in dev; point FCM_CREDENTIALS_PATH at a local file instead.
# FCM_CREDENTIALS_JSON_BASE64=

# ── Email / SMTP (email-service) ─────────────────────────────────────────────
# ON by default in dev, pointing at the `mailhog` compose service. Django's
# `email:send` publisher landed 2026-07-27, so signup-verify and password-reset
# Ordinary mail flows Django outbox -> Redis -> email-service -> SMTP.
# Secret-bearing OTP/invitation/delivery-code mail bypasses Redis and uses the
# same SMTP environment at Django's trusted final render/send boundary.
#
# Read the mail at http://localhost:8026 — nothing leaves your machine, so a dev
# box can never mail a real user. Port note: 1025 is the *in-network* port
# (services reach `mailhog:1025`); the host mapping is 1026/8026 to avoid
# colliding with anything already bound locally.
#
# Production: point at a real relay (Brevo/Gmail/Mailgun) — port 587 with
# EMAIL_USE_TLS=true + username/password, or 465 for implicit TLS. Set
# EMAIL_ENABLED=false to park the consumer without removing the service.
EMAIL_ENABLED=true
# Set `sender_net` in production to make provider intent explicit. Sender.net
# still uses the same SMTP worker and durable outbox; no vendor API call is
# made from domain code.
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=mailhog
EMAIL_SMTP_PORT=1025
EMAIL_USE_TLS=false
EMAIL_FROM_ADDR=noreply@shiptrip.dz
EMAIL_FROM_NAME=ShipTrip
# DEFAULT_FROM_EMAIL=ShipTrip <noreply@shiptrip.dz>
# EMAIL_STREAM=email:send
# EMAIL_CONSUMER_GROUP=email-send-workers
# EMAIL_CONSUMER_NAME=email-1
# One reminder before the stored protection deadline; default is 24 hours.
# PROTECTION_ENDING_REMINDER_SECONDS=86400
# Production requires this dedicated key even while delivery is disabled,
# because queued OTP/invitation/code obligations are encrypted at rest.
# TRANSACTIONAL_EMAIL_SECRET=<dedicated-32+-character-secret>
# EMAIL_SENDING_DOMAIN_VERIFIED=false
# Leave auth empty for mailhog; most real relays require both.
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=

# Sender.net production example (keep secrets in Railway/environment only):
# EMAIL_PROVIDER=sender_net
# EMAIL_SMTP_HOST=smtp.sender.net
# EMAIL_SMTP_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_SMTP_USERNAME=<Sender.net SMTP username>
# EMAIL_SMTP_PASSWORD=<Sender.net SMTP password>
# EMAIL_FROM_ADDR=noreply@your-verified-domain.example
# EMAIL_FROM_NAME=ShipTrip
# EMAIL_SUPPORT_ADDR=support@your-verified-domain.example
# FRONTEND_BASE_URL=https://shiptrip.example

# ── Google OAuth (optional in dev) ───────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_IDS=

# ── Admin bootstrap (one controlled initial run; remove password afterward) ──
# SHIPTRIP_SUPER_ADMIN_EMAIL=admin@example.com
# SHIPTRIP_SUPER_ADMIN_PASSWORD=<strong-temporary-secret>
# SHIPTRIP_SUPER_ADMIN_NAME=ShipTrip Super Admin

# ── V1 handover, disputes and boosts (Phase 4) ───────────────────────────────
# HANDOVER_CODE_SECRET is the root secret for pickup/delivery code hashing and
# sealing. It is deliberately NOT the Django SECRET_KEY: rotating or leaking the
# signing key is a session event, not a parcel-handover event, and the two must
# not share a blast radius. Production refuses to boot unless this is at least
# 32 characters AND different from DJANGO_SECRET_KEY. Dev and tests derive a
# deterministic fallback from SECRET_KEY, so a fresh checkout runs unconfigured.
#   openssl rand -base64 48
# HANDOVER_CODE_SECRET=

# Private bucket for dispute evidence (photos and video submitted by a party).
# Must NOT be public: access is always a short-lived signed URL issued after an
# authorization check. Managed out-of-band like the other buckets.
S3_BUCKET_DISPUTE=shiptrip-dispute
DISPUTE_EVIDENCE_URL_TTL_SECONDS=300

# Transport-level bound on handover-code submissions, on top of the per-code
# attempt budget and the per-deal sliding window enforced in the domain.
# DRF_HANDOVER_SUBMIT_THROTTLE_RATE=12/min
# DRF_HANDOVER_REVEAL_THROTTLE_RATE=30/min
# DRF_DISPUTE_EVIDENCE_THROTTLE_RATE=20/min

# ── Process topology / logging ───────────────────────────────────────────────
# WEB_CONCURRENCY=2
# RESERVATION_RELEASE_INTERVAL_SECONDS=60
# FINANCE_JOB_INTERVAL_SECONDS=30
# LOG_LEVEL=info
# PORT=8080
