msgstr "Bonjour %(recipient_name)s,"

msgid "Your ShipTrip delivery code"
msgstr "Votre code de livraison ShipTrip"

msgid "Keep this code private until the parcel is in your hands."
msgstr "Gardez ce code privé jusqu'à ce que le colis soit entre vos mains."

msgid "Delivery"
msgstr "Livraison"

msgid "Your parcel is on its way"
msgstr "Votre colis est en route"

msgid "Never share this code by phone, message or email with anyone before you have the parcel. ShipTrip will never ask you for it."
msgstr "Ne communiquez jamais ce code par téléphone, message ou e-mail avant d'avoir le colis. ShipTrip ne vous le demandera jamais."

