msgstr "Remboursement intégral de l'expéditeur"

msgid "Full traveler payout"
msgstr "Versement intégral au voyageur"

msgid "Partial split"
msgstr "Répartition partielle"

msgid "cancelled by the sender"
msgstr "annulée par l'expéditeur"

msgid "cancelled by the traveler"
msgstr "annulée par le voyageur"

