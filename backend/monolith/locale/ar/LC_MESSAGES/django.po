msgid "Amount"
msgstr "المبلغ"

msgid "Your sender"
msgstr "المُرسِل"

msgid "Hello,"
msgstr "مرحبًا،"

msgid "Hello %(recipient_name)s,"
msgstr "مرحبًا %(recipient_name)s،"

msgid "Your Wassla delivery code"
msgstr "رمز تسليم Wassla الخاص بك"

msgid "Keep this code private until the parcel is in your hands."
msgstr "احتفظ بهذا الرمز سريًا حتى يصبح الطرد بين يديك."

msgid "Delivery"
msgstr "التسليم"

msgid "Your parcel is on its way"
msgstr "طردك في الطريق"

msgid "Never share this code by phone, message or email with anyone before you have the parcel. Wassla will never ask you for it."
msgstr "لا تشارك هذا الرمز عبر الهاتف أو الرسائل أو البريد الإلكتروني قبل استلام الطرد. لن تطلبه منك Wassla أبدًا."

msgid "eligible"
msgstr "مؤهل"

msgid "scheduled"
msgstr "مجدول"

msgid "processing"
msgstr "قيد المعالجة"

msgid "paid"
msgstr "مدفوع"

msgid "needs attention"
msgstr "يتطلب الانتباه"

msgid "updated"
msgstr "محدّث"

msgid "Tracking number"
msgstr "رقم التتبع"

msgid "Give this code to the traveler only once the parcel is physically in your hands. Entering it confirms delivery and starts the payment protection window."
msgstr "أعطِ هذا الرمز للمسافر فقط بعد أن يصبح الطرد بين يديك فعليًا. إدخال الرمز يؤكد التسليم ويبدأ فترة حماية الدفع."

msgid "Your delivery code"
msgstr "رمز التسليم الخاص بك"

msgid "Confirm your Wassla email"
msgstr "أكّد بريدك الإلكتروني في Wassla"

msgid "Use this code to confirm your email address."
msgstr "استخدم هذا الرمز لتأكيد عنوان بريدك الإلكتروني."

msgid "Account"
msgstr "الحساب"

msgid "Welcome to Wassla"
msgstr "مرحبًا بك في Wassla"

msgid "It expires in 15 minutes. Wassla will never ask you to share this code outside the verification screen."
msgstr "تنتهي صلاحيته خلال 15 دقيقة. لن تطلب منك Wassla مشاركة هذا الرمز خارج شاشة التحقق."

msgid "Reset your Wassla password"
msgstr "أعد تعيين كلمة مرور Wassla"

msgid "Use this private code to reset your password."
msgstr "استخدم هذا الرمز السري لإعادة تعيين كلمة المرور."

msgid "Account security"
msgstr "أمان الحساب"

msgid "Reset your password"
msgstr "إعادة تعيين كلمة المرور"

msgid "It expires in 15 minutes. If you did not request this, ignore this email and keep your code private."
msgstr "تنتهي صلاحيته خلال 15 دقيقة. إذا لم تطلب ذلك، فتجاهل هذه الرسالة واحتفظ بالرمز سريًا."

msgid "Wassla identity verification update"
msgstr "تحديث التحقق من الهوية في Wassla"

msgid "Verification"
msgstr "التحقق"

msgid "Wassla flight ticket update"
msgstr "تحديث تذكرة الطيران في Wassla"

msgid "Payment needed for your Wassla delivery"
msgstr "يلزم الدفع لمتابعة توصيلك عبر Wassla"

msgid "Open Wassla to review the payment needed."
msgstr "افتح Wassla لمراجعة الدفعة المطلوبة."

msgid "Payment"
msgstr "الدفع"

msgid "A payment is needed to continue"
msgstr "يلزم الدفع للمتابعة"

msgid "Your Wassla payment is processing"
msgstr "دفعة Wassla قيد المعالجة"

msgid "The provider is still confirming your payment."
msgstr "لا يزال مزوّد الدفع يتحقّق من دفعتك."

msgid "Your payment is being confirmed"
msgstr "يجري تأكيد دفعتك"

msgid "Your Wassla payment needs attention"
msgstr "تتطلب دفعتك عبر Wassla اتخاذ إجراء"

msgid "The payment failed; open Wassla to try again."
msgstr "فشلت الدفعة؛ افتح Wassla للمحاولة مرة أخرى."

msgid "That payment did not go through"
msgstr "لم تكتمل هذه الدفعة"

msgid "Wassla payment confirmed"
msgstr "تم تأكيد دفعة Wassla"

msgid "Your payment is confirmed."
msgstr "تم تأكيد دفعتك."

msgid "Your payment is confirmed"
msgstr "تم تأكيد دفعتك"

msgid "This payment does not create a Wassla account or give access to the delivery. Keep the reference private and contact Wassla support if you need help."
msgstr "لا تنشئ هذه الدفعة حسابًا في Wassla ولا تمنح حق الاطلاع على تفاصيل التوصيل. احتفظ بالمرجع سريًا واتصل بدعم Wassla إذا احتجت إلى المساعدة."

msgid "Wassla refund update"
msgstr "تحديث استرداد المبلغ عبر Wassla"

msgid "More information is needed for your Wassla case"
msgstr "نحتاج إلى معلومات إضافية بشأن حالتك في Wassla"

msgid "Open Wassla to review the evidence request."
msgstr "افتح Wassla لمراجعة طلب الأدلة."

msgid "Dispute"
msgstr "النزاع"

msgid "We need a little more information"
msgstr "نحتاج إلى بعض المعلومات الإضافية"

msgid "Open the app to upload evidence. Never include a handover code."
msgstr "افتح التطبيق لرفع الأدلة. لا تُرفق أبدًا رمز تسليم أو استلام."

msgid "Wassla security notice"
msgstr "إشعار أمان من Wassla"

msgid "Your Wassla password was changed."
msgstr "تم تغيير كلمة مرور Wassla الخاصة بك."

msgid "Your password was changed"
msgstr "تم تغيير كلمة المرور"

msgid "If you did not make this change, reset your password immediately and contact Wassla support."
msgstr "إذا لم تُجرِ هذا التغيير، فأعد تعيين كلمة المرور فورًا واتصل بدعم Wassla."

msgid "Pickup confirmed"
msgstr "تم تأكيد الاستلام"

msgid "The traveler has collected your parcel."
msgstr "استلم المسافر طردك."

msgid "The traveler has collected your parcel"
msgstr "استلم المسافر طردك"

msgid "Your delivery code is now available"
msgstr "رمز التسليم متاح الآن"

msgid "Open Wassla to view the delivery code."
msgstr "افتح Wassla لعرض رمز التسليم."

msgid "The code is not in this email. Open the app to see it."
msgstr "الرمز غير موجود في هذه الرسالة. افتح التطبيق لعرضه."

msgid "Delivery confirmed"
msgstr "تم تأكيد التسليم"

msgid "The delivery code was accepted successfully."
msgstr "تم قبول رمز التسليم بنجاح."

msgid "The delivery is confirmed"
msgstr "تم تأكيد التسليم"

msgid "Payment protection has ended"
msgstr "انتهت حماية الدفع"

msgid "The protection window closed with no open dispute."
msgstr "انتهت فترة الحماية دون نزاع مفتوح."

msgid "Payment protection"
msgstr "حماية الدفع"

msgid "Payment protection ends soon"
msgstr "ستنتهي حماية الدفع قريبًا"

msgid "Open a dispute before the protection deadline if needed."
msgstr "افتح نزاعًا قبل موعد انتهاء الحماية إذا لزم الأمر."

msgid "A dispute has been opened"
msgstr "تم فتح نزاع"

msgid "The traveler's payout is frozen while the dispute is reviewed."
msgstr "يُعلَّق تحويل أرباح المسافر أثناء مراجعة النزاع."

msgid "Your dispute has been resolved"
msgstr "تم حل نزاعك"

msgid "Open Wassla to review the dispute outcome."
msgstr "افتح Wassla لمراجعة نتيجة النزاع."

msgid "Payout update"
msgstr "تحديث تحويل الأرباح"

msgid "Your Wassla payout status was updated."
msgstr "حُدّثت حالة تحويل أرباحك عبر Wassla."

msgid "Payout"
msgstr "تحويل الأرباح"

msgid "Your payout was updated"
msgstr "حُدّثت حالة تحويل أرباحك"

msgid "Delivery cancelled"
msgstr "أُلغي التوصيل"

msgid "This Wassla delivery has been cancelled."
msgstr "أُلغي هذا التوصيل عبر Wassla."

msgid "This delivery has been cancelled"
msgstr "أُلغي هذا التوصيل"

msgid "Leave a review"
msgstr "أضف تقييمًا"

msgid "You can now review the other party."
msgstr "يمكنك الآن تقييم الطرف الآخر."

msgid "After the delivery"
msgstr "بعد التسليم"

msgid "You can now leave a review"
msgstr "يمكنك الآن إضافة تقييم"

msgid "%(sender_name)s has sent you a parcel through Wassla and it is on its way."
msgstr "أرسل إليك %(sender_name)s طردًا عبر Wassla وهو في الطريق."

msgid "Enter this code on the verification screen to confirm your email address."
msgstr "أدخل هذا الرمز في شاشة التحقق لتأكيد عنوان بريدك الإلكتروني."

msgid "Your verification code"
msgstr "رمز التحقق الخاص بك"

msgid "Enter this code on the password reset screen."
msgstr "أدخل هذا الرمز في شاشة إعادة تعيين كلمة المرور."

msgid "Your password reset code"
msgstr "رمز إعادة تعيين كلمة المرور"

msgid "Your identity verification is approved."
msgstr "تمت الموافقة على التحقق من هويتك."

msgid "Your identity verification needs attention."
msgstr "يتطلب التحقق من هويتك اتخاذ إجراء."

msgid "Your identity verification is approved"
msgstr "تمت الموافقة على التحقق من هويتك"

msgid "Your identity verification needs attention"
msgstr "يتطلب التحقق من هويتك اتخاذ إجراء"

msgid "Open the Wassla app to see the next step."
msgstr "افتح تطبيق Wassla لمعرفة الخطوة التالية."

msgid "Your flight ticket is approved."
msgstr "اعتُمدت تذكرة طيرانك."

msgid "Your flight ticket needs attention."
msgstr "تتطلب تذكرة الطيران الخاصة بك اتخاذ إجراء."

msgid "Your flight ticket is approved"
msgstr "اعتُمدت تذكرة طيرانك"

msgid "Your flight ticket needs attention"
msgstr "تتطلب تذكرة الطيران الخاصة بك اتخاذ إجراء"

msgid "A payment is required before this delivery can continue."
msgstr "يلزم الدفع لمتابعة هذا التوصيل."

msgid "Open Wassla to review the amount and available provider."
msgstr "افتح Wassla لمراجعة المبلغ ومزوّدي الدفع المتاحين."

msgid "Your payment has been received by the provider and is being confirmed."
msgstr "استلم مزوّد الدفع دفعتك ويجري تأكيدها."

msgid "The payment provider could not complete this attempt."
msgstr "تعذر على مزوّد الدفع إكمال هذه المحاولة."

msgid "Open Wassla to retry or choose another available provider."
msgstr "افتح Wassla لإعادة المحاولة أو اختيار مزوّد آخر متاح."

msgid "Your payment is confirmed and the delivery can continue."
msgstr "تأكّد دفعك ويمكن الآن متابعة التوصيل."

msgid "Your Wassla payment receipt"
msgstr "إيصال الدفع عبر Wassla"

msgid "Your guest payment was confirmed."
msgstr "تم تأكيد دفعة الضيف."

msgid "Your guest payment is confirmed"
msgstr "تم تأكيد دفعة الضيف"

msgid "Your refund is complete."
msgstr "اكتمل استرداد المبلغ."

msgid "Your refund is being processed."
msgstr "يجري استرداد المبلغ."

msgid "Your refund is complete"
msgstr "اكتمل استرداد المبلغ"

msgid "Your refund is being processed"
msgstr "يجري استرداد المبلغ"

msgid "The time it takes to appear depends on the payment provider."
msgstr "تعتمد مدة ظهور المبلغ على مزوّد الدفع."

msgid "The Wassla trust team requested additional evidence."
msgstr "طلب فريق الثقة في Wassla أدلة إضافية."

msgid "The password for your Wassla account was changed."
msgstr "تم تغيير كلمة مرور حساب Wassla الخاص بك."

msgid "The traveler has confirmed pickup of your parcel."
msgstr "أكد المسافر استلام طردك."

msgid "The safety window has passed. You can now view the delivery code in the Wassla app, and the recipient has been emailed their copy."
msgstr "انتهت فترة الأمان. يمكنك الآن عرض رمز التسليم في تطبيق Wassla، وقد أُرسلت نسخة منه إلى المستلم عبر البريد الإلكتروني."

msgid "The delivery code was entered successfully and the delivery is confirmed."
msgstr "تم إدخال رمز التسليم بنجاح وتأكيد التسليم."

msgid "The protection window for this delivery has closed with no open dispute. The traveler's payout is now eligible."
msgstr "انتهت فترة الحماية لهذا التوصيل دون نزاع مفتوح. يمكن الآن تحويل أرباح المسافر."

msgid "If something is wrong with this delivery, open a dispute before the protection window closes."
msgstr "إذا واجهت مشكلة في هذا التوصيل، فافتح نزاعًا قبل انتهاء فترة الحماية."

msgid "A dispute has been opened on this delivery. The traveler's payout is frozen while it is reviewed."
msgstr "فُتح نزاع بشأن هذا التوصيل. يُعلَّق تحويل أرباح المسافر أثناء مراجعته."

msgid "This delivery has been cancelled."
msgstr "أُلغي هذا التوصيل."

msgid "Any refund due is processed automatically and appears in your payment history."
msgstr "تُعالج أي مبالغ مستحقة للاسترداد تلقائيًا وتظهر في سجل المدفوعات."

msgid "You can now review the other party for this delivery."
msgstr "يمكنك الآن تقييم الطرف الآخر في هذا التوصيل."

msgid "Reviews stay hidden until both sides have submitted or the review window closes."
msgstr "تبقى التقييمات مخفية حتى يرسلها الطرفان أو تنتهي فترة التقييم."

msgid "You can now publish a journey after its other checks pass."
msgstr "يمكنك الآن نشر رحلة بعد اجتياز عمليات التحقق الأخرى."

msgid "Please review the reason and submit updated documents."
msgstr "راجع السبب وأرسل مستندات محدّثة."

msgid "The verified flight leg can be used for matching."
msgstr "يمكن استخدام المرحلة الجوية المعتمدة في المطابقة."

msgid "Wassla ferry ticket update"
msgstr "تحديث تذكرة العبّارة في Wassla"

msgid "Your ferry ticket is approved."
msgstr "تمت الموافقة على تذكرة العبّارة الخاصة بك."

msgid "Your ferry ticket needs attention."
msgstr "تتطلب تذكرة العبّارة الخاصة بك اتخاذ إجراء."

msgid "Your ferry ticket is approved"
msgstr "تمت الموافقة على تذكرة العبّارة الخاصة بك"

msgid "Your ferry ticket needs attention"
msgstr "تتطلب تذكرة العبّارة الخاصة بك اتخاذ إجراء"

msgid "The verified sea leg can be used for matching."
msgstr "يمكن استخدام المرحلة البحرية المعتمدة في المطابقة."

msgid "Please review the reason and submit updated proof."
msgstr "راجع السبب وأرسل إثباتًا محدّثًا."

msgid "Journey reference"
msgstr "مرجع الرحلة"

msgid "Payment reference"
msgstr "مرجع الدفع"

msgid "Your Wassla guest payment needs attention"
msgstr "يتطلب دفعك بصفتك ضيفًا في Wassla اتخاذ إجراء"

msgid "Your Wassla guest payment"
msgstr "دفعة الضيف في Wassla"

msgid "Your guest payment did not complete."
msgstr "لم تكتمل دفعة الضيف."

msgid "A guest payment update is available."
msgstr "يتوفر تحديث بشأن دفعة الضيف."

msgid "Your guest payment did not go through"
msgstr "لم تكتمل دفعة الضيف"

msgid "Your guest payment"
msgstr "دفعة الضيف"

msgid "Wassla received this payment for the reference below."
msgstr "استلمت Wassla هذه الدفعة للمرجع الموضح أدناه."

msgid "Wassla has completed the refund shown below."
msgstr "أكملت Wassla استرداد المبلغ الموضح أدناه."

msgid "Wassla has started the refund shown below."
msgstr "بدأت Wassla استرداد المبلغ الموضح أدناه."

msgid "Dispute reference"
msgstr "مرجع النزاع"

msgid "Your delivery code becomes available in %(minutes)s minutes, and the recipient is emailed at the same time."
msgstr "سيصبح رمز التسليم متاحًا خلال %(minutes)s دقيقة، وسيُرسل إلى المستلم عبر البريد الإلكتروني في الوقت نفسه."

msgid "Payment protection runs until"
msgstr "تستمر حماية الدفع حتى"

msgid "Protection ends at"
msgstr "تنتهي الحماية في"

msgid "A Wassla administrator has resolved this dispute. Open Wassla to see the outcome."
msgstr "حلّ أحد مسؤولي Wassla هذا النزاع. افتح Wassla للاطلاع على النتيجة."

msgid "Your Wassla payout was updated. Open Wassla to see its current status."
msgstr "حُدّثت حالة تحويل أرباحك. افتح Wassla للاطلاع عليها."

msgid "Reason"
msgstr "السبب"

msgid "Reason: %(reason)s"
msgstr "السبب: %(reason)s"

msgid "The provider could not complete this guest payment."
msgstr "تعذر على مزوّد الدفع إكمال دفعة الضيف هذه."

msgid "the end of the window"
msgstr "نهاية الفترة"

msgid "A Wassla administrator has resolved this dispute as: %(resolution)s."
msgstr "حلّ أحد مسؤولي Wassla هذا النزاع بالنتيجة التالية: %(resolution)s."

msgid "A security or account change was made"
msgstr "تم إجراء تغيير أمني أو تعديل في الحساب"

msgid "There was a security or account change."
msgstr "حدث تغيير أمني أو تعديل في الحساب."

msgid "Your Wassla payout status is now %(status)s."
msgstr "حالة تحويل أرباحك عبر Wassla الآن: %(status)s."

msgid "cancelled"
msgstr "ملغاة"

msgid "Wassla will never ask you for a pickup or delivery code, and will never ask you to share one before the parcel is in your hands."
msgstr "لن تطلب منك Wassla أبدًا رمز الاستلام أو التسليم، ولن تطلب منك مشاركته قبل أن يصبح الطرد بين يديك."

msgid "You are receiving this because of a delivery or account action on Wassla. This is a transactional message, not marketing."
msgstr "تلقيت هذه الرسالة بسبب إجراء متعلق بتوصيل أو بحسابك على Wassla. هذه رسالة خدمية وليست رسالة تسويقية."

msgid "Questions? Reply to this email."
msgstr "لديك سؤال؟ رد على هذه الرسالة."

msgid "You are receiving this because of a delivery or account action on %(shiptrip)s. This is a transactional message, not marketing."
msgstr "تلقيت هذه الرسالة بسبب إجراء متعلق بتوصيل أو بحسابك على %(shiptrip)s. هذه رسالة خدمية وليست رسالة تسويقية."

msgid "Questions? Reply to this email or write to %(support_link)s."
msgstr "لديك سؤال؟ رد على هذه الرسالة أو راسل %(support_link)s."

msgid "Questions? Reply to this email or write to %(support_email)s."
msgstr "لديك سؤال؟ رد على هذه الرسالة أو راسل %(support_email)s."

msgid "EU ↔ Algeria"
msgstr "الاتحاد الأوروبي ↔ الجزائر"

msgid "Full sender refund"
msgstr "ردّ المبلغ كاملًا إلى المُرسِل"

msgid "Full traveler payout"
msgstr "تحويل أرباح المسافر كاملةً"

msgid "Partial split"
msgstr "تقسيم جزئي"

msgid "cancelled by the sender"
msgstr "ألغى المُرسِل التوصيل"

msgid "cancelled by the traveler"
msgstr "ألغى المسافر التوصيل"

msgid "cancelled after the traveler changed the times"
msgstr "أُلغيت بعد أن غيّر المسافر المواعيد"

msgid "cancelled by an administrator"
msgstr "ألغى أحد المسؤولين التوصيل"

msgid "You have been invited to Wassla Operations"
msgstr "تمت دعوتك للانضمام إلى عمليات Wassla"

msgid "Use your private link to accept this invitation."
msgstr "استخدم رابطك الخاص لقبول هذه الدعوة."

msgid "Operations"
msgstr "العمليات"

msgid "Support"
msgstr "الدعم"

msgid "Finance"
msgstr "الشؤون المالية"

msgid "Trust / Verification"
msgstr "الثقة / التحقق"

msgid "Super Admin"
msgstr "المسؤول الرئيسي"

msgid "A Wassla administrator invited you to join the operations team."
msgstr "دعاك أحد مسؤولي Wassla للانضمام إلى فريق العمليات."

msgid "Accept your invitation"
msgstr "قبول دعوتك"

msgid "This private link can be used once. If you were not expecting this, contact Wassla support."
msgstr "يمكن استخدام هذا الرابط الخاص مرة واحدة. إذا لم تكن تتوقع هذه الدعوة، فتواصل مع دعم Wassla."

msgid "Role"
msgstr "الدور"

msgid "Expires at"
msgstr "تنتهي الصلاحية في"

msgid "Use this code before it expires. Wassla will never ask you to share this code outside the verification screen."
msgstr "استخدم هذا الرمز قبل انتهاء صلاحيته. لن تطلب منك Wassla أبدًا مشاركة هذا الرمز خارج شاشة التحقق."

msgid "Use this code before it expires. If you did not request this, ignore this email and keep your code private."
msgstr "استخدم هذا الرمز قبل انتهاء صلاحيته. إذا لم تطلب ذلك، فتجاهل هذا البريد وحافظ على سرية الرمز."

msgid "Password"
msgstr "كلمة المرور"

msgid "Name (optional)"
msgstr "الاسم (اختياري)"

msgid "The invitation could not be accepted. Check the link and password, or contact your administrator."
msgstr "تعذر قبول الدعوة. تحقق من الرابط وكلمة المرور، أو تواصل مع المسؤول."

msgid "Please try again later."
msgstr "يُرجى إعادة المحاولة لاحقًا."

msgid "Language"
msgstr "اللغة"

msgid "Your invitation has been accepted."
msgstr "تم قبول دعوتك."

msgid "Open Wassla Operations"
msgstr "فتح لوحة عمليات Wassla"

msgid "For an existing account, enter your current password. For a new account, choose a strong password."
msgstr "لحساب موجود، أدخل كلمة مرورك الحالية. لحساب جديد، اختر كلمة مرور قوية."

msgid "If a different account is signed in, sign out before accepting."
msgstr "إذا كان هناك حساب آخر مسجل الدخول، فسجّل الخروج قبل القبول."

msgid "Enable JavaScript to load your private invitation link."
msgstr "فعّل JavaScript لفتح رابط دعوتك الخاص."

msgid "We need a new upload of your identity document."
msgstr "نحتاج إلى إعادة رفع وثيقة هويتك."

msgid "We need a new upload of your identity document"
msgstr "نحتاج إلى إعادة رفع وثيقة هويتك"

msgid "Please read the reason below and upload your document again."
msgstr "يرجى قراءة السبب أدناه وإعادة رفع وثيقتك."

msgid "Open the Wassla app to upload it again."
msgstr "افتح تطبيق Wassla لإعادة رفعها."

msgid "We need a new upload of your ferry ticket"
msgstr "نحتاج إلى إعادة رفع تذكرة العبّارة"

msgid "We need a new upload of your flight ticket"
msgstr "نحتاج إلى إعادة رفع تذكرة الطيران"

msgid "Please read the reason below and upload the ticket again."
msgstr "يرجى قراءة السبب أدناه وإعادة رفع التذكرة."
