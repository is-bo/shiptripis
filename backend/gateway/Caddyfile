# ShipTrip API gateway. Upstreams default to docker-compose service names and
# are overridden with Railway private-network addresses when hosted.
# Per ARCHITECTURE.md §3: Caddy does NOT validate JWTs — services do their own.
# Production sets shutdown_timeout 30s for graceful WS drain on rolling deploys.

{
	admin off
	auto_https off
}

:{$PORT:80} {
	respond /healthz "ok" 200

	# More specific Go-service paths must be evaluated BEFORE the generic
	# /api/* matcher, otherwise Django swallows them.

	@chat path /ws/chat /ws/chat/*
	handle @chat {
		reverse_proxy {$CHAT_UPSTREAM:chat-service:8081}
	}

	@notif path /ws/notifications /ws/notifications/*
	handle @notif {
		reverse_proxy {$NOTIFICATION_UPSTREAM:notification-service:8082}
	}

	@kyc path /kyc/* /api/kyc/*
	handle @kyc {
		reverse_proxy {$KYC_UPSTREAM:kyc-service:8083}
	}

	# Keep the public marketing bundle static and outside Django's authenticated
	# routes. The compose deployment mounts ../web read-only at this path.
	@public path / /index.html /en/* /fr/* /ar/* /assets/* /terms.html /privacy.html /prohibited-items.html /support.html /robots.txt /sitemap.xml
	handle @public {
		root * /srv/shiptrip-web
		encode gzip
		file_server
	}

	# Django REST + admin + static (catch-all).
	reverse_proxy {$DJANGO_UPSTREAM:django:8000} {
		# Railway terminates TLS before this container. Preserve the edge
		# scheme so Django's production HTTPS redirect does not loop.
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}
}
