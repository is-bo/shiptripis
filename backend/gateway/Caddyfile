# ShipTrip API gateway (dev).
# Per ARCHITECTURE.md §3: Caddy does NOT validate JWTs — services do their own.
# Production sets shutdown_timeout 30s for graceful WS drain on rolling deploys.

{
	admin off
	auto_https off
}

:80 {
	respond /healthz "ok" 200

	# More specific Go-service paths must be evaluated BEFORE the generic
	# /api/* matcher, otherwise Django swallows them.

	@chat path /ws/chat /ws/chat/*
	handle @chat {
		reverse_proxy chat-service:8081
	}

	@notif path /ws/notifications /ws/notifications/*
	handle @notif {
		reverse_proxy notification:8082
	}

	@kyc path /kyc/* /api/kyc/*
	handle @kyc {
		reverse_proxy kyc-service:8083
	}

	@media path /media-svc/* /api/media/*
	handle @media {
		reverse_proxy media-service:8084
	}

	# Django REST + admin + static (catch-all).
	reverse_proxy django:8000
}
