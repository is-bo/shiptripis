# ShipTrip API gateway for the local docker-compose stack. Upstreams default to
# the compose service names. The VPS image uses infra/vps/gateway.Caddyfile.
# Per ARCHITECTURE.md §3: Caddy does NOT validate JWTs — services do their own.
# Production sets shutdown_timeout 30s for graceful WS drain on rolling deploys.

{
	admin off
	auto_https off
}

:{$PORT:80} {
	# Ordinary API requests stay bounded at 12 MB. KYC is excluded and gets a
	# route-specific allowance matching its upstream 25 MiB hard cap below.
	@bounded_body {
		not path /kyc/* /api/kyc/*
	}
	request_body @bounded_body {
		max_size 12MB
	}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
	reverse_proxy /healthz {$DJANGO_UPSTREAM:django:8000}
	reverse_proxy /readyz {$DJANGO_UPSTREAM:django:8000}

	# More specific Go-service paths must be evaluated BEFORE the generic
	# /api/* matcher, otherwise Django swallows them.

	@chat path /ws/chat /ws/chat/*
	handle @chat {
		reverse_proxy {$CHAT_UPSTREAM:chat-service:8081}
	}

	@notif path /ws/notifications /ws/notifications/*
	handle @notif {
		reverse_proxy {$NOTIFICATION_UPSTREAM:notification-service:8082}
	}

	@kyc path /kyc/* /api/kyc/*
	handle @kyc {
		# 27 decimal MB > the authoritative 25 MiB (26,214,400-byte) service cap.
		request_body {
			max_size 27MB
		}
		reverse_proxy {$KYC_UPSTREAM:kyc-service:8083}
	}

	# Keep the public marketing bundle static and outside Django's authenticated
	# routes. The compose deployment mounts ../web read-only at this path.
	@public path / /index.html /en/* /fr/* /ar/* /assets/* /terms /terms/ /terms.html /privacy /privacy/ /privacy.html /prohibited-items /prohibited-items/ /prohibited-items.html /support /support/ /support.html /robots.txt /sitemap.xml /favicon.ico
	handle @public {
		header Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'"
		header Cache-Control "public, max-age=300"
		root * /srv/shiptrip-web
		rewrite /terms /terms.html
		rewrite /terms/ /terms.html
		rewrite /privacy /privacy.html
		rewrite /privacy/ /privacy.html
		rewrite /prohibited-items /prohibited-items.html
		rewrite /prohibited-items/ /prohibited-items.html
		rewrite /support /support.html
		rewrite /support/ /support.html
		encode gzip
		file_server
	}

	# Django REST + admin + static (catch-all).
	reverse_proxy {$DJANGO_UPSTREAM:django:8000} {
		# TLS is terminated before this proxy. Preserve the edge scheme so
		# Django's production HTTPS redirect does not loop.
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}
}
