# Separate mode-0600 file. Never used by application/edge containers.
RESTIC_REPOSITORY=s3:https://REPLACE_WITH_BACKUP_ENDPOINT/REPLACE_WITH_BACKUP_BUCKET
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ONLY_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_ONLY_SECRET_KEY
AWS_DEFAULT_REGION=REPLACE_WITH_REGION
# Required owner decisions, unrelated to legal application-record retention.
BACKUP_KEEP_DAILY=REPLACE_WITH_COUNT
BACKUP_KEEP_WEEKLY=REPLACE_WITH_COUNT
BACKUP_KEEP_MONTHLY=REPLACE_WITH_COUNT
