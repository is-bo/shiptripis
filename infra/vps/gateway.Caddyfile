# In-container gateway of the VPS application image. The host-published edge
# (infra/vps/Caddyfile) terminates TLS and forwards here over the private
# Docker network, so client addresses are trusted only from private ranges.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
	# No access logs, but the error logger still records the request URI of a
	# failed request (a 502 while Django is down), and a guest payment link's
	# path is its credential. Redact it there; infra/vps/tests/test_proxy_logs.py.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "/(pay|api/payments)/guest/[^/?#]+" "/${1}/guest/REDACTED"
				request>headers>Referer regexp "/(pay|api/payments)/guest/[^/?#]+" "/${1}/guest/REDACTED"
			}
		}
	}
}
:{$PORT:8080} {
	# Keep the ordinary API ceiling tight. KYC has a separate upstream cap of
	# 25 MiB (three 8 MiB images plus multipart framing), so it is excluded here.
	@bounded_body {
		not path /kyc/* /api/kyc/*
	}
	request_body @bounded_body {
		max_size 12MB
	}
	header {
		X-Content-Type-Options "nosniff"
		# Defer to a page that sets its own policy (capability pages send no-referrer).
		?Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=2592000; includeSubDomains"
		-Server
	}
	# Health is served by Django, so the container is not reported healthy
	# merely because the gateway started.
	reverse_proxy /healthz 127.0.0.1:8000 {
		header_up Host localhost
		header_up X-Forwarded-Proto https
	}
	reverse_proxy /readyz 127.0.0.1:8000 {
		header_up Host localhost
		header_up X-Forwarded-Proto https
	}

	@chat path /ws/chat /ws/chat/*
	handle @chat {
		reverse_proxy 127.0.0.1:8081
	}

	@notif path /ws/notifications /ws/notifications/*
	handle @notif {
		reverse_proxy 127.0.0.1:8082
	}

	@kyc path /kyc/* /api/kyc/*
	handle @kyc {
		# 27 decimal MB > the authoritative 25 MiB (26,214,400-byte) service cap.
		request_body {
			max_size 27MB
		}
		# The Go service registers /kyc/submit. Normalize the public /api/kyc
		# alias before proxying so both documented forms reach the handler.
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8083
	}

	# Public marketing and policy pages are static and deliberately isolated
	# from the authenticated Django/admin surface. Keep this matcher before
	# the API catch-all so a missing public asset can never be proxied into an
	# admin endpoint.
	@public path / /index.html /en/* /fr/* /ar/* /assets/* /terms /terms/ /terms.html /privacy /privacy/ /privacy.html /prohibited-items /prohibited-items/ /prohibited-items.html /support /support/ /support.html /delete-account /delete-account/ /delete-account.html /robots.txt /sitemap.xml /favicon.ico
	handle @public {
		header Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'"
		header Cache-Control "public, max-age=300"
		root * /web
		rewrite /terms /terms.html
		rewrite /terms/ /terms.html
		rewrite /privacy /privacy.html
		rewrite /privacy/ /privacy.html
		rewrite /prohibited-items /prohibited-items.html
		rewrite /prohibited-items/ /prohibited-items.html
		rewrite /support /support.html
		rewrite /support/ /support.html
		rewrite /delete-account /delete-account.html
		rewrite /delete-account/ /delete-account.html
		encode gzip
		file_server
	}

	# Django REST, admin, and static files.
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
	}
}
