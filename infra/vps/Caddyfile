{
	admin off
	email {$ACME_EMAIL}
	# No access logs, but the error logger still records the request of a
	# failed one (a 502 while the app is down), and a guest payment link's path
	# is its credential, in whatever encoding the client sent. So the URI and
	# the Referer are not logged at all; infra/vps/tests/test_proxy_logs.py.
	log {
		exclude http.log.error
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
	# `handle_errors` below answers every proxy error, and Caddy then records
	# the error at debug level; this log keeps those lines, and only those.
	log proxy_errors {
		include http.log.error
		level DEBUG
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
			}
		}
	}
}

{$SITE_ADDRESS} {
	{$TLS_DIRECTIVE}
	# The only public listener. No raw access logs: URLs may carry guest tokens.
	@internal path /debug/* /metrics /metrics/*
	respond @internal 404
	@adminDenied {
		path /admin /admin/* /api/admin /api/admin/*
		not remote_ip {$ADMIN_CIDRS}
	}
	respond @adminDenied 403
	@badOrigin {
		path /ws/*
		header Origin *
		not header Origin {$WEBSOCKET_ORIGINS}
	}
	respond @badOrigin 403
	header {
		-Server
		X-Content-Type-Options nosniff
		# Preserve stricter policies on pages carrying private capabilities.
		?Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=2592000; includeSubDomains"
	}
	reverse_proxy app:8080 {
		# Set this from the actual transport; never trust client-supplied XFP.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
	}
	# An error answered here (the app down: 502) never reaches Django, which
	# sets the guest page's private headers. Set them on every such error, not
	# by a path match an encoded URL could slip past.
	handle_errors {
		header Referrer-Policy no-referrer
		header Cache-Control "private, no-store"
	}
}

# Container-local liveness, not an additional published management endpoint.
http://127.0.0.1:8089 {
	respond /healthz 200
}
