{
	admin off
	email {$ACME_EMAIL}
	# No access logs, but the error logger still records the request URI of a
	# failed request (a 502 while the app is down), and a guest payment link's
	# path is its credential. Redact it there; infra/vps/tests/test_proxy_logs.py.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "/(pay|api/payments)/guest/[^/?#]+" "/${1}/guest/REDACTED"
				request>headers>Referer regexp "/(pay|api/payments)/guest/[^/?#]+" "/${1}/guest/REDACTED"
			}
		}
	}
}

{$SITE_ADDRESS} {
	{$TLS_DIRECTIVE}
	# The only public listener. No raw access logs: URLs may carry guest tokens.
	@internal path /debug/* /metrics /metrics/*
	respond @internal 404
	@adminDenied {
		path /admin /admin/* /api/admin /api/admin/*
		not remote_ip {$ADMIN_CIDRS}
	}
	respond @adminDenied 403
	@badOrigin {
		path /ws/*
		header Origin *
		not header Origin {$WEBSOCKET_ORIGINS}
	}
	respond @badOrigin 403
	header {
		-Server
		X-Content-Type-Options nosniff
		# Preserve stricter policies on pages carrying private capabilities.
		?Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=2592000; includeSubDomains"
	}
	reverse_proxy app:8080 {
		# Set this from the actual transport; never trust client-supplied XFP.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
	}
}

# Container-local liveness, not an additional published management endpoint.
http://127.0.0.1:8089 {
	respond /healthz 200
}
