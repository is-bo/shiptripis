# Copy outside the repository. This file is config, not a shell script.
APP_IMAGE=wacla-app:REPLACE_WITH_40_CHARACTER_REVIEWED_GIT_SHA
BACKUP_IMAGE=wacla-backup:REPLACE_WITH_40_CHARACTER_REVIEWED_GIT_SHA
RELEASE_ID=REPLACE_WITH_40_CHARACTER_REVIEWED_GIT_SHA
SECRETS_DIR=/etc/wacla/secrets
BACKUP_ENV_FILE=/etc/wacla/backup.env
STACK_ENV_FILE=/etc/wacla/stack.env
SITE_ADDRESS=REPLACE_WITH_DOMAIN
ACME_EMAIL=REPLACE_WITH_OPERATOR_EMAIL
BIND_IP=0.0.0.0
# Space-separated, trusted actual client sources; never 0.0.0.0/0.
ADMIN_CIDRS=REPLACE_WITH_APPROVED_ADMIN_CIDR
WEBSOCKET_ORIGINS=https://REPLACE_WITH_DOMAIN
SHIPTRIP_ENVIRONMENT=production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_DOMAIN,localhost
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_DOMAIN
CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_DOMAIN
POSTGRES_DB=wacla
POSTGRES_USER=wacla
WEB_CONCURRENCY=4
WEB_THREADS=2
KYC_GRPC_WORKERS=4
CHAT_DB_MAX_CONNS=8
NOTIF_DB_MAX_CONNS=6
EMAIL_DB_MAX_CONNS=2
RESERVATION_RELEASE_INTERVAL_SECONDS=60
FINANCE_JOB_INTERVAL_SECONDS=30
GRPC_AUTH_MODE=bearer
GRPC_ALLOW_PRIVATE_BEARER=true
S3_ENDPOINT_URL=https://REPLACE_WITH_EXTERNAL_STORAGE_ENDPOINT
S3_REGION=REPLACE_WITH_REGION
S3_USE_PATH_STYLE=false
S3_BUCKET_PARCEL=REPLACE_WITH_PRIVATE_MEDIA_BUCKET
S3_BUCKET_PROOF=REPLACE_WITH_PRIVATE_PROOF_BUCKET
S3_BUCKET_DISPUTE=REPLACE_WITH_PRIVATE_DISPUTE_BUCKET
S3_BUCKET_KYC=REPLACE_WITH_PRIVATE_KYC_BUCKET
KYC_S3_ENDPOINT_URL=https://REPLACE_WITH_KYC_STORAGE_ENDPOINT
KYC_S3_REGION=REPLACE_WITH_REGION
KYC_S3_USE_PATH_STYLE=false
PAYOUT_PROFILES_ENABLED=false
PAYOUT_DZD_EXECUTION_ENABLED=false
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_PAYOUTS_ENABLED=false
STRIPE_CONNECT_NON_STRIPE_FUNDING_ENABLED=false
STRIPE_CONNECT_EXPECTED_MODE=test
STRIPE_CONNECT_API_VERSION=2026-03-25.dahlia
STRIPE_CONNECT_ALLOWED_COUNTRIES=
STRIPE_CONNECT_PLATFORM_ACCOUNT_ID=
STRIPE_CONNECT_ONBOARDING_RETURN_URL=
STRIPE_CONNECT_ONBOARDING_REFRESH_URL=
S3_BUCKET_PAYOUT=
PAYOUT_S3_ENDPOINT_URL=
PAYOUT_S3_REGION=
PAYOUT_S3_USE_PATH_STYLE=false
PAYMENTS_ENVIRONMENT=test
PAYMENTS_ALLOW_MOCK_PROVIDER=false
PAYMENTS_PUBLIC_BASE_URL=https://REPLACE_WITH_DOMAIN
STRIPE_API_BASE=https://api.stripe.com
CHARGILY_API_BASE=https://pay.chargily.net/test/api/v2
EMAIL_ENABLED=false
EMAIL_ACTIVATION_APPROVED=false
EMAIL_ACTIVATION_NOT_BEFORE=
EMAIL_PROVIDER=sender_net
EMAIL_USE_TLS=true
EMAIL_SENDING_DOMAIN_VERIFIED=false
EMAIL_SMTP_HOST=smtp.sender.net
EMAIL_SMTP_PORT=587
EMAIL_SMTP_TIMEOUT_SECONDS=10
EMAIL_RATE_LIMIT_PER_MINUTE=60
EMAIL_FROM_NAME=Wassla
EMAIL_FROM_ADDR=
EMAIL_SUPPORT_ADDR=
EMAIL_REPLY_TO=
FRONTEND_BASE_URL=https://REPLACE_WITH_DOMAIN
FCM_ENABLED=false
FCM_PROJECT_ID=
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_SIGN_IN_CLIENT_IDS=
SENTRY_DSN=
LOG_LEVEL=info
PERFORMANCE_ACCESS_LOG_ENABLED=true
PERFORMANCE_DB_METRICS_ENABLED=false
RETENTION_ENABLED=false
RETENTION_JOB_DAYS=
RETENTION_PUSH_DAYS=
RETENTION_MEDIA_HOURS=
