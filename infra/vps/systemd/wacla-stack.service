[Unit]
Description=Waçla container stack (explicit migrations required before first start)
Requires=docker.service
After=docker.service network-online.target wacla-docker-firewall.service
PartOf=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/wacla
Environment=WACLA_CONFIG=/etc/wacla/stack.env
ExecStart=/opt/wacla/infra/vps/vps start
ExecStop=/opt/wacla/infra/vps/vps stop
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
WantedBy=docker.service
