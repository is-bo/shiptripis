// Sign in with Google and Sign in with Apple on iOS. Both stay empty in Git
// and inert until Ismail sets them; the Runner's "Check sign-in settings"
// build phase (ios/scripts/check_social_sign_in.sh) fails a build whose
// build defines disagree with them.
//
// GOOGLE_IOS_CLIENT_PREFIX  the iOS OAuth client id without its
//                           ".apps.googleusercontent.com" ending, such as
//                           1234567890-abcdef. The URL scheme Google returns
//                           to (com.googleusercontent.apps.<prefix>) is made
//                           from it, and the GOOGLE_IOS_CLIENT_ID define must
//                           be <prefix>.apps.googleusercontent.com.
//
// APPLE_SIGN_IN_ENTITLEMENTS Runner/Runner.entitlements once the App ID has
//                           the Sign in with Apple capability; empty, the
//                           app is signed without it. Required when the
//                           build defines APPLE_SIGN_IN_ENABLED=true.
GOOGLE_IOS_CLIENT_PREFIX =
APPLE_SIGN_IN_ENTITLEMENTS =
